{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.os/schemas/viral_opportunity.schema.json",
  "title": "MOTION.OS Viral Opportunity",
  "type": "object",
  "additionalProperties": false,
  "required": ["opportunity_id","signal_id","account_id","goal","audience_id","features","score","decision","rationale","evidence_refs"],
  "properties": {
    "opportunity_id": {"type":"string","minLength":1},
    "signal_id": {"type":"string","minLength":1},
    "account_id": {"type":"string","minLength":1},
    "goal": {"enum":["REACH","AUTHORITY","PROOF","CONVERSION"]},
    "audience_id": {"type":"string","minLength":1},
    "topic_family": {"type":["string","null"]},
    "freshness_class": {"enum":["BREAKING","CURRENT","EVERGREEN","STALE","UNKNOWN"]},
    "claim_state": {"enum":["CONFIRMED","RUMOR","INFERENCE","OPINION","MIXED","UNKNOWN"]},
    "features": {
      "type":"object",
      "additionalProperties": false,
      "required":["audience_relevance","consequence_stakes","novelty_timing","evidence_availability","tension","utility","visual_potential","share_save_potential","brand_offer_fit"],
      "properties": {
        "audience_relevance":{"type":"number","minimum":0,"maximum":1},
        "consequence_stakes":{"type":"number","minimum":0,"maximum":1},
        "novelty_timing":{"type":"number","minimum":0,"maximum":1},
        "evidence_availability":{"type":"number","minimum":0,"maximum":1},
        "tension":{"type":"number","minimum":0,"maximum":1},
        "utility":{"type":"number","minimum":0,"maximum":1},
        "visual_potential":{"type":"number","minimum":0,"maximum":1},
        "share_save_potential":{"type":"number","minimum":0,"maximum":1},
        "brand_offer_fit":{"type":"number","minimum":0,"maximum":1}
      }
    },
    "weights": {"type":"object","additionalProperties":{"type":"number","minimum":0}},
    "score": {"type":"number","minimum":0,"maximum":100},
    "decision": {"enum":["PRODUCE","REFRAME_OR_BACKLOG","DROP","OVERRIDE_PRODUCE"]},
    "rationale": {"type":"array","minItems":1,"items":{"type":"string"}},
    "evidence_refs": {"type":"array","items":{"type":"string"}},
    "proof_asset_refs": {"type":"array","items":{"type":"string"}},
    "offer_id": {"type":["string","null"]},
    "created_at": {"type":["string","null"],"format":"date-time"}
  }
}
