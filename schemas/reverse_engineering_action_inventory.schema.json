{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.os/schemas/reverse_engineering_action_inventory.schema.json",
  "title": "MOTION.OS Reverse Engineering Atomic Action Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "video_id", "source_sha256", "fps", "scenes", "actions"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "video_id": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scene_id", "start_frame", "end_frame", "role", "description"],
        "properties": {
          "scene_id": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 1},
          "role": {"type": "string"},
          "description": {"type": "string"}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "scene_id", "start_frame", "impact_frame", "end_frame", "start_ms", "end_ms", "domain", "verb", "target", "function", "parameters", "audio_link", "z_role", "authority", "confidence", "evidence_refs", "renderer_mapping"],
        "properties": {
          "action_id": {"type": "string"},
          "scene_id": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 0},
          "impact_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 0},
          "start_ms": {"type": "number", "minimum": 0},
          "end_ms": {"type": "number", "minimum": 0},
          "domain": {"type": "string"},
          "verb": {"type": "string"},
          "target": {"type": "string"},
          "function": {"type": "string"},
          "parameters": {"type": "object"},
          "audio_link": {"type": ["string", "null"]},
          "z_role": {"type": ["string", "null"]},
          "temporal_mode": {"enum": ["discrete", "continuous", "staggered", "hold", "compound", "source_native"]},
          "motion_origin": {"enum": ["editorial", "source_native", "mixed", "unknown"]},
          "authority": {"enum": ["measured", "measured_heuristic", "measured_visible", "evidence_bound_inference", "inferred_from_mixed_audio", "assumption", "unknown"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "subevents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subevent_id", "start_frame", "impact_frame", "end_frame", "verb", "target", "parameters", "authority", "confidence", "evidence_refs"],
              "properties": {
                "subevent_id": {"type": "string", "minLength": 1},
                "start_frame": {"type": "integer", "minimum": 0},
                "impact_frame": {"type": "integer", "minimum": 0},
                "end_frame": {"type": "integer", "minimum": 0},
                "verb": {"type": "string", "minLength": 1},
                "target": {"type": "string", "minLength": 1},
                "parameters": {"type": "object"},
                "authority": {"enum": ["measured", "measured_heuristic", "measured_visible", "evidence_bound_inference", "inferred_from_mixed_audio", "assumption", "unknown"]},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}}
              }
            }
          },
          "renderer_mapping": {
            "type": "object",
            "additionalProperties": false,
            "required": ["after_effects", "remotion", "hyperframes"],
            "properties": {
              "after_effects": {"type": "string", "minLength": 1},
              "remotion": {"type": "string", "minLength": 1},
              "hyperframes": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
