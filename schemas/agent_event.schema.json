{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.os/schemas/agent_event.schema.json",
  "title": "MOTION.OS AgentEvent v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","event_id","project_id","actor_id","event_type","aggregate_type","aggregate_id","aggregate_revision","correlation_id","recorded_at","idempotency_key","payload_hash","payload","provenance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "event_id": {"type":"string","minLength":8},
    "project_id": {"type":"string","pattern":"^motion://project/"},
    "actor_id": {"type":"string","pattern":"^motion://agent/"},
    "session_id": {"type":["string","null"],"pattern":"^motion://session/"},
    "event_type": {"type":"string","pattern":"^[A-Z][A-Z0-9_]+$"},
    "aggregate_type": {"type":"string","minLength":1},
    "aggregate_id": {"type":"string","minLength":1},
    "aggregate_revision": {"type":"integer","minimum":0},
    "expected_revision": {"type":["integer","null"],"minimum":0},
    "causation_id": {"type":["string","null"]},
    "correlation_id": {"type":"string","minLength":8},
    "parent_event_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
    "workstream_id": {"type":["string","null"]},
    "resource_scope": {"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]},
    "git": {
      "type":["object","null"],
      "additionalProperties":false,
      "properties": {
        "repository": {"type":"string"},
        "branch": {"type":["string","null"]},
        "base_sha": {"type":["string","null"]},
        "commit_sha": {"type":["string","null"]},
        "pr_number": {"type":["integer","null"],"minimum":1}
      }
    },
    "observed_at": {"type":["string","null"],"format":"date-time"},
    "recorded_at": {"type":"string","format":"date-time"},
    "idempotency_key": {"type":"string","minLength":8,"maxLength":256},
    "payload_hash": {"type":"string","pattern":"^[a-f0-9]{64}$"},
    "payload": {"type":"object"},
    "provenance": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "additionalProperties":false,
        "required":["source_type","source_id"],
        "properties": {
          "source_type":{"type":"string"},
          "source_id":{"type":"string"},
          "revision":{"type":["string","null"]},
          "sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}
        }
      }
    },
    "sensitivity": {"enum":["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED"],"default":"INTERNAL"},
    "evidence": {"type":"array","items":{"type":"string"},"uniqueItems":true,"default":[]}
  }
}
