{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.os/schemas/editing_graph.schema.json",
  "title": "MOTION.OS EditingGraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_id", "project_id", "nodes", "edges"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "graph_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "graph_revision": {"type": "integer", "minimum": 1, "default": 1},
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/edge"}
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "created_from": {"type": ["string", "null"]},
        "git_sha": {"type": ["string", "null"]},
        "authority": {"enum": ["fixture", "sampled", "ground_truth", "authoritative"]}
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "level", "data"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "Project", "Brief", "Intent", "EmotionState", "NarrativeBeat", "BrandRule", "AttentionTarget", "ProductSemantic", "StyleSignature", "MotionGrammar", "NegativeConstraint",
            "Scene", "Shot", "Layer", "Track", "Asset", "AssetVariant", "Primitive", "Transition", "CameraRig", "Material", "LightRig", "TypographyRole", "AudioCue", "MusicBeat", "VoiceLine", "Effect", "Mask", "CompositionBlueprint",
            "Renderer", "Skill", "Provider", "ToolCall", "Composition", "RenderRegion", "Artifact", "Run", "QAResult", "Defect", "RootCause", "RepairCandidate", "Release"
          ]
        },
        "level": {"enum": ["L1_SEMANTIC", "L2_EDITING", "L3_RENDER_EVIDENCE"]},
        "continuity_id": {"type": ["string", "null"]},
        "authority": {"enum": ["fixture", "inferred", "measured", "ground_truth", "authoritative"]},
        "provenance_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "data": {"type": "object", "additionalProperties": true}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "relation"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "relation": {
          "enum": [
            "REQUIRES", "DRIVES", "SHAPES", "MATERIALIZES_AS", "CONTAINS", "USES", "ANIMATED_BY", "CONSTRAINED_BY", "ENTERS_VIA", "EXITS_VIA", "SOURCED_FROM", "SUPPORTED_BY", "DERIVED_FROM", "CONDITIONS", "COMPILES_TO", "RENDERED_BY", "REQUIRES_SKILL", "SYNC_WITH", "FLAGS", "CAUSED_BY", "GENERATES", "MUTATES", "PRODUCED_BY", "INVALIDATES", "DEPENDS_ON", "ROUTES_TO", "EVALUATES", "PROMOTES", "ROLLS_BACK_TO"
          ]
        },
        "required": {"type": "boolean", "default": true},
        "data": {"type": "object", "additionalProperties": true}
      }
    }
  }
}
