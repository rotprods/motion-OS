{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.os/schemas/context_pack.schema.json",
  "title": "MOTION.OS Agent ContextPack",
  "type": "object",
  "additionalProperties": false,
  "required": ["context_pack_id","project_id","agent_id","session_id","generated_at","stale_after","main_sha","projection_version","projection_hash","allowed_write_scopes","forbidden_write_scopes","source_refs","seal_sha256"],
  "properties": {
    "context_pack_id": {"type":"string"},
    "project_id": {"type":"string","pattern":"^motion://project/"},
    "agent_id": {"type":"string","pattern":"^motion://agent/"},
    "session_id": {"type":"string","pattern":"^motion://session/"},
    "generated_at": {"type":"string","format":"date-time"},
    "stale_after": {"type":"string","format":"date-time"},
    "main_sha": {"type":"string","minLength":7},
    "projection_version": {"type":"integer","minimum":1},
    "projection_hash": {"type":"string","pattern":"^[a-fA-F0-9]{64}$"},
    "goal_summary": {"type":"string"},
    "release_gates": {"type":"array","items":{"type":"string"}},
    "active_prs": {"type":"array","items":{"type":"object"}},
    "active_agents": {"type":"array","items":{"type":"object"}},
    "active_leases": {"type":"array","items":{"type":"object"}},
    "dependency_neighborhood": {"type":"array","items":{"type":"object"}},
    "relevant_decisions": {"type":"array","items":{"type":"object"}},
    "relevant_contracts": {"type":"array","items":{"type":"object"}},
    "unresolved_conflicts": {"type":"array","items":{"type":"object"}},
    "checkpoint_refs": {"type":"array","items":{"type":"string"}},
    "allowed_write_scopes": {"type":"array","items":{"type":"string"}},
    "forbidden_write_scopes": {"type":"array","items":{"type":"string"}},
    "expected_revisions": {"type":"object"},
    "source_refs": {"type":"array","items":{"type":"object"}},
    "seal_sha256": {"type":"string","pattern":"^[a-fA-F0-9]{64}$"}
  }
}
