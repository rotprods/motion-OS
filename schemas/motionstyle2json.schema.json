    "cameraPlan":{"type":"object","required":["rig_id","framing","motion","focus_behavior","no_shake"],"properties":{"rig_id":{"type":"string"},"framing":{"enum":["wide","medium","macro","other"]},"motion":{"enum":["static","micro_drift","linear_slide","dolly_in","dolly_out","arc_pan","orbit","other"]},"z_drift":{"type":["number","null"]},"focus_behavior":{"enum":["locked","micro_pull","rack_focus","other"]},"no_shake":{"type":"boolean"},"transform_6dof":{"$ref":"#/$defs/transform6dof"},"pivot_target":{"type":["string","null"]},"screen_anchor":{"type":["object","null"]},"velocity_curve":{"type":["object","null"]}},"additionalProperties":true},
    "heroPlan":{"type":"object","properties":{"target":{"type":["string","null"]},"transform_6dof":{"$ref":"#/$defs/transform6dof"},"screen_anchor":{"type":["object","null"]},"identity_lock":{"type":"boolean"}},"additionalProperties":true},
    "causalTransition":{"type":"object","properties":{"approach":{"type":"object"},"feature_acquisition":{"type":"object"},"transformation":{"type":"object"},"crossing":{"type":"object"},"handoff":{"type":"object"},"resolve":{"type":"object"},"focus_plane":{"type":["object","null"]},"occlusion_pct":{"type":["object","null"]},"mask_topology":{"type":["string","null"]},"screen_anchor":{"type":["object","null"]},"motion_vector":{"type":["object","null"]},"speed_curve":{"type":["object","null"]},"motion_blur":{"type":["object","null"]},"incoming_scene_relation":{"type":["string","null"]},"audio_impulse":{"type":["object","null"]},"confidence":{"type":["number","null"],"minimum":0,"maximum":1},"evidence_refs":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},
    "transitionSpec":{"type":"object","required":["type","at_ms_global"],"properties":{"type":{"type":"string"},"at_ms_global":{"type":"integer","minimum":0},"supporting_fx":{"type":"array","items":{"type":"string"}},"notes":{"type":["string","null"]},"causal":{"anyOf":[{"$ref":"#/$defs/causalTransition"},{"type":"null"}]}},"additionalProperties":true},
    "choreographyStep":{"type":"object","required":["id","at_ms","at_frame","target","action","channels","from","to","duration_ms","ease","notes"],"properties":{"id":{"type":"string"},"at_ms":{"type":"integer","minimum":0},"at_frame":{"type":"integer","minimum":0},"target":{"type":"string"},"action":{"enum":["enter","exit","settle","trace","underline","focus_pull","parallax_shift","material_highlight","occlude","reveal","camera_move","speed_ramp","roto_lock","detach","cross_plane","other"]},"channels":{"type":"array","items":{"enum":["x","y","z","yaw","pitch","roll","scale","rotation","opacity","blur","glow","shadow","mask","clipPath","color","noise","grain","focus","occlusion","velocity"]}},"from":{},"to":{},"duration_ms":{"type":"integer","minimum":0},"ease":{"type":"string"},"notes":{"type":"string"}},"additionalProperties":true}
  }
