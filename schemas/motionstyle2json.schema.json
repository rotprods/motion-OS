    "video": {"type":"object","required":["duration_ms","fps","resolution","aspect_ratio"],"properties":{"duration_ms":{"type":"integer","minimum":0},"fps":{"type":"number","exclusiveMinimum":0},"resolution":{"type":"object","required":["w","h"],"properties":{"w":{"type":"integer","minimum":1},"h":{"type":"integer","minimum":1}},"additionalProperties":false},"aspect_ratio":{"type":"string"}},"additionalProperties":true},
