{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion-os.local/schemas/motionstyle2json.schema.json",
  "title": "MotionStyle2JSON v1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "video", "style_system", "camera_rigs", "shots", "evidence", "quality", "compiler_targets"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "video": {
      "type": "object",
      "required": ["duration_ms", "fps", "resolution", "aspect_ratio"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "resolution": {"type": "object", "required": ["w", "h"], "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
        "aspect_ratio": {"type": "string"}
      },
      "additionalProperties": true
    },
    "style_system": {
      "type": "object",
      "required": ["style_family", "color", "typography", "composition", "motion", "materials_3d", "fx"],
      "properties": {
        "style_family": {"type": "array", "items": {"$ref": "#/$defs/confidentLabel"}},
        "color": {"type": "object"},
        "typography": {"type": "object"},
        "composition": {"type": "object"},
        "motion": {"type": "object"},
        "materials_3d": {"type": "array", "items": {"type": "string"}},
        "fx": {"type": "array", "items": {"type": "string"}},
        "ui_language": {"type": ["object", "null"]},
        "timing_rules": {"type": "array", "items": {"type": "object"}},
        "failure_modes": {"type": "array", "items": {"type": "string"}},
        "mitigations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "camera_rigs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rig_id", "type"],
        "properties": {
          "rig_id": {"type": "string"},
          "type": {"enum": ["overhead", "macro_slider", "ui_plate", "other"]},
          "parameters": {"type": "object"},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start_ms", "end_ms", "on_screen_text", "camera_plan", "depth_plan", "transition_spec", "motion_events", "micro_choreography"],
        "properties": {
          "id": {"type": "string"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "on_screen_text": {"type": "array", "items": {"type": "object"}},
          "palette": {"type": "array", "items": {"type": "string"}},
          "composition_tokens": {"type": "array", "items": {"type": "string"}},
          "camera_plan": {
            "type": "object",
            "required": ["rig_id", "framing", "motion", "focus_behavior", "no_shake"],
            "properties": {
              "rig_id": {"type": "string"},
              "framing": {"enum": ["wide", "medium", "macro", "other"]},
              "motion": {"enum": ["static", "micro_drift", "linear_slide", "dolly_in", "dolly_out", "other"]},
              "z_drift": {"type": ["number", "null"]},
              "focus_behavior": {"enum": ["locked", "micro_pull", "other"]},
              "no_shake": {"type": "boolean"}
            },
            "additionalProperties": true
          },
          "depth_plan": {
            "type": "object",
            "required": ["layers_z", "materials_cues", "occlusion_events"],
            "properties": {
              "layers_z": {"type": "array", "items": {"type": "object", "required": ["id", "z_index", "parallax_ratio"], "properties": {"id": {"type": "string"}, "z_index": {"type": "number"}, "parallax_ratio": {"type": "number"}}, "additionalProperties": true}},
              "materials_cues": {"type": "array", "items": {"type": "object"}},
              "occlusion_events": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          },
          "transition_spec": {"type": "object", "required": ["type", "at_ms_global"], "properties": {"type": {"type": "string"}, "at_ms_global": {"type": "integer", "minimum": 0}, "supporting_fx": {"type": "array", "items": {"type": "string"}}, "notes": {"type": ["string", "null"]}}, "additionalProperties": true},
          "motion_events": {"type": "array", "items": {"type": "object"}},
          "micro_choreography": {"type": "array", "items": {"$ref": "#/$defs/choreographyStep"}}
        },
        "additionalProperties": true
      }
    },
    "evidence": {
      "type": "object",
      "required": ["keyframes", "timestamps", "claims"],
      "properties": {
        "keyframes": {"type": "array", "items": {"type": "object"}},
        "timestamps": {"type": "array", "items": {"type": "object"}},
        "claims": {"type": "array", "items": {"$ref": "#/$defs/evidenceClaim"}}
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "required": ["coverage", "warnings", "assumptions"],
      "properties": {
        "coverage": {"type": "object"},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "compiler_targets": {
      "type": "object",
      "required": ["remotion", "framer_motion"],
      "properties": {
        "remotion": {
          "type": "object",
          "required": ["project", "scene_boundaries", "z_order"],
          "properties": {
            "project": {"type": "object", "required": ["fps", "width", "height", "duration_frames"], "properties": {"fps": {"type": "number", "exclusiveMinimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}, "duration_frames": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
            "scene_boundaries": {"type": "array", "items": {"type": "object", "required": ["shot_id", "from_frame", "to_frame"], "properties": {"shot_id": {"type": "string"}, "from_frame": {"type": "integer", "minimum": 0}, "to_frame": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
            "z_order": {"type": "array", "items": {"type": "string"}}
          },
          "additionalProperties": true
        },
        "framer_motion": {
          "type": "object",
          "required": ["easing_presets", "motion_contracts"],
          "properties": {"easing_presets": {"type": "object"}, "motion_contracts": {"type": "object"}},
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "confidentLabel": {
      "type": "object",
      "required": ["id", "confidence", "evidence_refs"],
      "properties": {"id": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}},
      "additionalProperties": true
    },
    "evidenceClaim": {
      "type": "object",
      "required": ["claim_id", "label", "confidence", "evidence_refs", "status"],
      "properties": {"claim_id": {"type": "string"}, "label": {"type": "string"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "evidence_refs": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["observed", "inferred", "assumption"]}},
      "additionalProperties": true
    },
    "choreographyStep": {
      "type": "object",
      "required": ["id", "at_ms", "at_frame", "target", "action", "channels", "from", "to", "duration_ms", "ease", "notes"],
      "properties": {
        "id": {"type": "string"},
        "at_ms": {"type": "integer", "minimum": 0},
        "at_frame": {"type": "integer", "minimum": 0},
        "target": {"type": "string"},
        "action": {"enum": ["enter", "exit", "settle", "trace", "underline", "focus_pull", "parallax_shift", "material_highlight", "occlude", "reveal", "other"]},
        "channels": {"type": "array", "items": {"enum": ["x", "y", "z", "scale", "rotation", "opacity", "blur", "glow", "shadow", "mask", "clipPath", "color", "noise", "grain"]}},
        "from": {},
        "to": {},
        "duration_ms": {"type": "integer", "minimum": 0},
        "ease": {"type": "string"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
