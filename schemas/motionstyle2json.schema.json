    "shots": {"type":"array","items":{"type":"object","required":["id","start_ms","end_ms","on_screen_text","camera_plan","depth_plan","transition_spec","motion_events","micro_choreography"],"properties":{"id":{"type":"string"},"start_ms":{"type":"integer","minimum":0},"end_ms":{"type":"integer","minimum":0},"on_screen_text":{"type":"array","items":{"type":"object"}},"palette":{"type":"array","items":{"type":"string"}},"composition_tokens":{"type":"array","items":{"type":"string"}},"camera_plan":{"$ref":"#/$defs/cameraPlan"},"hero_plan":{"anyOf":[{"$ref":"#/$defs/heroPlan"},{"type":"null"}]},"depth_plan":{"type":"object","required":["layers_z","materials_cues","occlusion_events"],"properties":{"layers_z":{"type":"array","items":{"type":"object","required":["id","z_index","parallax_ratio"],"properties":{"id":{"type":"string"},"z_index":{"type":"number"},"parallax_ratio":{"type":"number"}},"additionalProperties":true}},"materials_cues":{"type":"array","items":{"type":"object"}},"occlusion_events":{"type":"array","items":{"type":"string"}}},"additionalProperties":false},"transition_spec":{"$ref":"#/$defs/transitionSpec"},"motion_events":{"type":"array","items":{"type":"object"}},"micro_choreography":{"type":"array","items":{"$ref":"#/$defs/choreographyStep"}}},"additionalProperties":true}},
