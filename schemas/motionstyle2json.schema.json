    "compiler_targets": {"type":"object","required":["remotion","framer_motion"],"properties":{"remotion":{"type":"object","required":["project","scene_boundaries","z_order"],"properties":{"project":{"type":"object","required":["fps","width","height","duration_frames"],"properties":{"fps":{"type":"number","exclusiveMinimum":0},"width":{"type":"integer","minimum":1},"height":{"type":"integer","minimum":1},"duration_frames":{"type":"integer","minimum":1}},"additionalProperties":false},"scene_boundaries":{"type":"array","items":{"type":"object","required":["shot_id","from_frame","to_frame"],"properties":{"shot_id":{"type":"string"},"from_frame":{"type":"integer","minimum":0},"to_frame":{"type":"integer","minimum":0}},"additionalProperties":false}},"z_order":{"type":"array","items":{"type":"string"}}},"additionalProperties":true},"framer_motion":{"type":"object","required":["easing_presets","motion_contracts"],"properties":{"easing_presets":{"type":"object"},"motion_contracts":{"type":"object"}},"additionalProperties":true},"generative_video":{"type":"object"}},"additionalProperties":true}
