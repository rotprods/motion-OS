{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion.os/schemas/content_experiment.schema.json",
  "title": "MOTION.OS Content Experiment",
  "type": "object",
  "additionalProperties": false,
  "required": ["experiment_id","hypothesis","primary_metric","manipulated_variable","variants","status","causal_claim_allowed"],
  "properties": {
    "experiment_id":{"type":"string","minLength":1},
    "hypothesis":{"type":"string","minLength":1},
    "primary_metric":{"type":"string","minLength":1},
    "guardrail_metrics":{"type":"array","items":{"type":"string"}},
    "baseline_query":{"type":["object","null"]},
    "manipulated_variable":{"enum":["HOOK","FIRST_FRAME","DURATION","PROOF_ORDER","CTA_PLACEMENT","VISUAL_TREATMENT","OTHER"]},
    "variants":{"type":"array","minItems":2,"items":{"type":"object","required":["variant_id"],"properties":{"variant_id":{"type":"string"},"content_id":{"type":["string","null"]},"value":{}}}},
    "platforms":{"type":"array","items":{"type":"string"}},
    "audience_constraints":{"type":["object","null"]},
    "sample_target":{"type":["integer","null"],"minimum":1},
    "start_at":{"type":["string","null"],"format":"date-time"},
    "end_at":{"type":["string","null"],"format":"date-time"},
    "confounders":{"type":"array","items":{"type":"string"}},
    "status":{"enum":["DESIGNED","RUNNING","ANALYZING","COMPLETED","ABORTED","QUARANTINED"]},
    "effect_estimate":{"type":["number","null"]},
    "confidence":{"type":["number","null"],"minimum":0,"maximum":1},
    "uncertainty_notes":{"type":["string","null"]},
    "supporting_content_ids":{"type":"array","items":{"type":"string"}},
    "decision":{"type":["string","null"]},
    "causal_claim_allowed":{"type":"boolean"},
    "evidence_refs":{"type":"array","items":{"type":"string"}}
  }
}
