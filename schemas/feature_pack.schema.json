{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motion-os.local/schemas/feature_pack.schema.json",
  "title": "MOTION.OS Feature Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "video_meta", "shots", "keyframes", "ocr", "color_stats", "layout_stats", "motion_stats", "asset_stats", "audio_stats", "extraction_provenance", "warnings"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "video_meta": {
      "type": "object",
      "required": ["duration_ms", "fps", "resolution", "aspect_ratio"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "resolution": {
          "type": "object",
          "required": ["w", "h"],
          "properties": {"w": {"type": "integer", "minimum": 1}, "h": {"type": "integer", "minimum": 1}},
          "additionalProperties": false
        },
        "aspect_ratio": {"type": "string"},
        "codec": {"type": ["string", "null"]},
        "bitrate": {"type": ["integer", "null"], "minimum": 0}
      },
      "additionalProperties": true
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "start_ms", "end_ms", "start_frame", "end_frame", "confidence", "method"],
        "properties": {
          "id": {"type": "string"},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 0},
          "start_frame": {"type": "integer", "minimum": 0},
          "end_frame": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "method": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "keyframes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "shot_id", "frame", "at_ms", "sha256"],
        "properties": {
          "id": {"type": "string"}, "shot_id": {"type": "string"}, "frame": {"type": "integer", "minimum": 0}, "at_ms": {"type": "integer", "minimum": 0}, "sha256": {"type": "string"}, "artifact_ref": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "ocr": {"type": "array", "items": {"$ref": "#/$defs/evidenceItem"}},
    "color_stats": {"type": "object"},
    "layout_stats": {"type": "object"},
    "motion_stats": {"type": "object"},
    "fx_stats": {"type": "object"},
    "asset_stats": {"type": "object"},
    "audio_stats": {"type": "object"},
    "extraction_provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "method", "version"],
        "properties": {"module": {"type": "string"}, "method": {"type": "string"}, "version": {"type": "string"}, "parameters": {"type": "object"}},
        "additionalProperties": false
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["id", "confidence", "method", "evidence_refs"],
      "properties": {
        "id": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "method": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  }
}
