      "after_effects":["FOOTAGE_LAYER subject","NULL reframe","TEXT_LAYER que/sea","TEXT_LAYER CIENTÍFICAMENTE","TEXT_LAYER imposible","audio markers"],
      "remotion":["Sequence subject","ReframeWrapper","caption setup component","hero keyword component","tail component","audio-event data"],
      "hyperframes":["video clip","transform wrapper","caption DOM layers","registered paused GSAP timeline","audio clip/labels"]
    },
    {
      "scene_id":"S11_UI_LIST",
      "canonical":"red field + status pill + hook/cursor + progressive caption + three semantic UI rows",
      "after_effects":["shape background","status precomp","shape icon/arrow","caption precomps","UI row precomps"],
      "remotion":["SVG/CSS background","status component","arrow SVG","caption components","row components/Sequences"],
