{
  "schema_version": "1.0.0",
  "source_sha256": "9b3076cb542e358386942a0fb6b160f1345564d4326738f9a340e2b5b38e199d",
  "principle": "After Effects, Remotion and HyperFrames execute one canonical editing graph; mappings are implementation translations, not creative reinterpretations.",
  "canonical_channels": {
    "layer_in_out": {"after_effects":"layer.inPoint/outPoint","remotion":"Sequence from/durationInFrames","hyperframes":"data-start/data-duration"},
    "position_2d": {"after_effects":"Transform.Position","remotion":"style transform translate / interpolate","hyperframes":"GSAP x/y"},
    "scale": {"after_effects":"Transform.Scale","remotion":"style transform scale / interpolate/spring adapter","hyperframes":"GSAP scale"},
    "rotation_z": {"after_effects":"Transform.Rotation","remotion":"style transform rotate","hyperframes":"GSAP rotation"},
    "opacity": {"after_effects":"Transform.Opacity","remotion":"style opacity / interpolate","hyperframes":"GSAP opacity"},
    "mask": {"after_effects":"Mask/Track Matte","remotion":"SVG mask/clipPath/CSS clipPath","hyperframes":"SVG mask/CSS clip-path"},
    "z_order": {"after_effects":"layer stacking / 3D Z when justified","remotion":"zIndex + optional 3D transform","hyperframes":"CSS z-index + optional translateZ"},
    "precomp": {"after_effects":"CompItem/precomp","remotion":"React component + Sequence","hyperframes":"composition or semantic DOM group"},
    "text": {"after_effects":"TextLayer/Text Animator","remotion":"independent React text geometry + Caption timing data","hyperframes":"DOM text + GSAP timeline"},
    "bezier_ease": {"after_effects":"KeyframeEase / temporal bezier","remotion":"Easing.bezier adapter","hyperframes":"GSAP custom/cubic ease"},
    "snappy_overshoot": {"after_effects":"3-key scale curve / Graph Editor","remotion":"explicit frame interpolation or calibrated spring","hyperframes":"GSAP keyframes/fromTo sequence"},
    "audio_event": {"after_effects":"layer marker/comp marker + audio waveform reference","remotion":"frame-derived event timestamp / Audio track","hyperframes":"separate audio clip + timeline label"}
  },
  "golden_scene_equivalence": [
    {
