  "hard_rules": [
    "Frame index remains the authoritative timebase.",
    "Do not replace hard source cuts with long transitions in exact reconstruction.",
    "Do not collapse independent hero/setup/tail captions into one text renderer.",
    "Do not invert DepthGraph z-order to satisfy renderer convenience.",
    "Do not use renderer-specific randomization or browser-clock timing.",
    "If a renderer cannot reproduce a property, surface a capability gap rather than silently redesigning it."
  ]
}
